{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Knotebook",
  "version": "0.1.5",
  "identifier": "dev.borck.knotebook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Knotebook",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMkY2QjQwRDBCQ0NCMzUKUldRMXk3elFRR3N2U2xGR0dYN0E2dnpKUGpyUmxRU240SCtSRHVDcXF1R042bEdja0VUaTVQcVcK",
      "endpoints": [
        "https://github.com/michael-borck/Knotebook/releases/latest/download/latest.json"
      ]
    }
  }
}

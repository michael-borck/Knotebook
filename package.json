{
  "name": "knotebook",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run clean:appledouble",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "smoke": "tsx scripts/smoke.ts",
    "store:build": "tsx scripts/build-catalogue.ts",
    "store:demo": "tsx scripts/make-sample-pack.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "deploy:site": "bash scripts/deploy-site.sh",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean:appledouble": "node scripts/clean-appledouble.mjs",
    "desktop:dev": "npm run clean:appledouble && CARGO_TARGET_DIR=\"$HOME/Library/Caches/knotebook-target\" tauri dev",
    "desktop:build": "npm run clean:appledouble && CARGO_TARGET_DIR=\"$HOME/Library/Caches/knotebook-target\" tauri build",
    "check": "npm run typecheck && npm run smoke"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@mavnn/codemirror-lang-ink": "^0.10.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.1",
    "dagre": "^0.8.5",
    "inkjs": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
